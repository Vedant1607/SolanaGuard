{
  "name": "solanaguard",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:push": "turbo run db:push --filter=@solanaguard/database",
    "db:migrate": "turbo run db:migrate --filter=@solanaguard/database",
    "db:seed": "turbo run db:seed --filter=@solanaguard/database",
    "db:studio": "turbo run db:studio --filter=@solanaguard/database"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.9",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
